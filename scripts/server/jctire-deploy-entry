#!/usr/bin/env bash
# SSH forced command for the `deploy` user. This is the ONLY thing the CI key
# can run. Accepts exactly:  deploy <40-hex-sha>   |   rollback
# Anything else is rejected. Real work happens in jctire-deploy-root via sudo.
set -euo pipefail
cmd="${SSH_ORIGINAL_COMMAND:-}"
if [[ "$cmd" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  exec sudo -n /usr/local/bin/jctire-deploy-root deploy "${BASH_REMATCH[1]}"
elif [[ "$cmd" == "rollback" ]]; then
  exec sudo -n /usr/local/bin/jctire-deploy-root rollback
fi
echo "rejected" >&2
exit 1
